rules_version = '2';

// Camiguin Market — Firebase Storage rules alang sa mga litrato sa listing.
//
// Ang litrato gitipigan sa `listing_images/{uid}/{timestamp}.jpg`.
// Kinahanglan naka-log in aron makakita, ug ang user makasulat ra sa iyang
// kaugalingong folder.
//
// I-deploy:  firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    match /listing_images/{userId}/{fileName} {
      // Ang mga customer kinahanglan maka-kita sa litrato, apan kinahanglan log in.
      allow read: if request.auth != null;

      // Upload o ilis sa litrato: kaugalingong folder, image ra, ubos sa 5 MB.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny sa ubang dalan.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
