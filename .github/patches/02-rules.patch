diff --git a/firestore.rules b/firestore.rules
index 29b5e73..a65ca14 100644
--- a/firestore.rules
+++ b/firestore.rules
@@ -41,6 +41,18 @@ service cloud.firestore {
         && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
     }
 
+    // Payments: an order may not switch its payment method after checkout, and
+    // orders written before the payment fields existed keep working.
+    function paymentMethodUnchanged() {
+      return request.resource.data.get('paymentMethod', 'cash')
+        == resource.data.get('paymentMethod', 'cash');
+    }
+
+    function paymentStatusUnchanged() {
+      return request.resource.data.get('paymentStatus', 'cod')
+        == resource.data.get('paymentStatus', 'cod');
+    }
+
     // The admins list is readable by signed-in users (so the app can check it),
     // but it cannot be written from the app.
     match /admins/{userId} {
@@ -196,6 +208,8 @@ service cloud.firestore {
         && (resource.data.buyerId == request.auth.uid
             || resource.data.sellerId == request.auth.uid);
 
+      // Cash orders are paid on hand-over ("cod"); GCash orders start
+      // "unpaid" and the buyer must not be able to claim them paid.
       allow create: if request.auth != null
         && request.resource.data.buyerId == request.auth.uid
         && request.resource.data.sellerId is string
@@ -203,19 +217,48 @@ service cloud.firestore {
         && request.resource.data.total >= 0
         && request.resource.data.quantity is number
         && request.resource.data.quantity > 0
-        && request.resource.data.status == "pending";
-
-      // The seller can change the status at any time; the buyer can cancel
-      // only while `pending`, and cannot swap the order's parties.
+        && request.resource.data.status == "pending"
+        // Orders from app versions released before GCash carry no payment
+        // fields, so they default to cash/cod; when the fields are present
+        // they must be consistent. A buyer can never create a paid order.
+        && request.resource.data.get('paymentMethod', 'cash') in ['cash', 'gcash']
+        && request.resource.data.get('paymentStatus', 'cod') == (
+          request.resource.data.get('paymentMethod', 'cash') == 'cash' ? 'cod' : 'unpaid'
+        )
+        && request.resource.data.get('paymentRef', '') == '';
+
+      // The seller can change the status and confirm the GCash payment; the
+      // buyer can cancel while `pending`, or record the GCash reference once.
+      // Neither can swap the parties or the payment method.
       allow update: if request.auth != null
         && request.resource.data.sellerId == resource.data.sellerId
         && request.resource.data.buyerId == resource.data.buyerId
+        && paymentMethodUnchanged()
         && (
-          resource.data.sellerId == request.auth.uid
+          (
+            resource.data.sellerId == request.auth.uid
+            && (
+              paymentStatusUnchanged()
+              || (resource.data.get('paymentMethod', 'cash') == 'gcash'
+                  && request.resource.data.get('paymentStatus', 'cod') == 'paid')
+            )
+          )
           || (
             resource.data.buyerId == request.auth.uid
-            && resource.data.status == "pending"
-            && request.resource.data.status == "cancelled"
+            && (
+              (resource.data.status == "pending"
+                && request.resource.data.status == "cancelled"
+                && paymentStatusUnchanged())
+              || (
+                resource.data.get('paymentMethod', 'cash') == 'gcash'
+                && resource.data.get('paymentStatus', 'cod') == 'unpaid'
+                && request.resource.data.get('paymentStatus', 'cod') == 'pending'
+                && request.resource.data.status == resource.data.status
+                && request.resource.data.get('paymentRef', '') is string
+                && request.resource.data.get('paymentRef', '').size() > 0
+                && request.resource.data.get('paymentRef', '').size() <= 40
+              )
+            )
           )
         );
 
