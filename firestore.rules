rules_version = '2';

// Camiguin Market — Firestore security rules.
//
// Palisiya:
//   - Kinahanglan naka-log in (Firebase Auth) aron makabasa sa listings.
//   - Ang tag-iya (sellerId == uid) ra ang makabuhat, makausab, ug makapapas
//     sa iyang listing.
//   - Wala nay laing collection nga gibuksan; default deny ang tanan.
//
// I-deploy:  firebase deploy --only firestore:rules
// (o i-paste sa Firebase Console → Firestore → Rules).
//
// Awtomatiko usab kining ma-deploy sa GitHub Actions (Firestore rules workflow)
// ug ma-test sa Firestore emulator sa wala pa kini mo-abot sa production.

service cloud.firestore {
  match /databases/{database}/documents {

    // Ang listing balido kon kompleto ang importante nga fields ug husto ang tipo.
    function validListing(data) {
      return data.sellerId is string
        && data.sellerId.size() > 0
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.price is number
        && data.price >= 0
        && data.contact is string
        && data.contact.size() <= 60
        // Optional ang pickup coordinates, apan kon naa kinahanglan numero.
        && (!('latitude' in data) || data.latitude == null || data.latitude is number)
        && (!('longitude' in data) || data.longitude == null || data.longitude is number);
    }

    match /listings/{listingId} {
      // Ang customer kinahanglan makakita sa mga listing, apan kinahanglan log in.
      allow read: if request.auth != null;

      // Ang seller ra ang makahimo og listing sa iyang kaugalingong ngalan.
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && validListing(request.resource.data);

      // Dili ma-transfer ang listing ngadto sa laing seller.
      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid
        && validListing(request.resource.data);

      // Gigamit usab ni sa account deletion (papason ang tanan listing sa user).
      allow delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid;
    }

    // Cart: ang user ra ang makabasa/makasulat sa iyang kaugalingong cart.
    match /carts/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Paborito: pareho sa cart, kaugalingon ra.
    match /favorites/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications: ang tag-iya ra ang makabasa ug makausab; ang bisan kinsang
    // naka-log in makahimo og notification para sa uban, apan ang `fromUid`
    // kinahanglan siya gayud (dili makapanghimakak sa laing tawo).
    match /notifications/{userId}/items/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200;
    }

    // Orders: ang buyer makahimo; ang buyer ug ang seller ra ang makabasa.
    // Ang seller ra ang makausab sa status.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.status == "pending";

      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId;

      allow delete: if false;
    }

    // Chat: ang duha ka participants ra ang makabasa/makasulat.
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;
        allow update, delete: if false;
      }
    }

    // Default deny sa ubang dalan.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
