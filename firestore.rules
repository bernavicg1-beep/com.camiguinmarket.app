rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCommunityVerified(uid) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(uid)).data.verified == true;
    }

    // -----------------------------------------------------------------------
    // Users
    // -----------------------------------------------------------------------

    match /users/{uid} {
      // Anyone signed in can read a profile.
      allow read: if isSignedIn();

      // A user may create their own profile. Trust fields (phoneVerified,
      // verified) are set ONLY by the phone-verify flow or by an admin.
      allow create: if isOwner(uid)
        && !('phoneVerified' in request.resource.data)
        && !('verified' in request.resource.data)
        && !('verifiedBy' in request.resource.data)
        && !('verifiedAt' in request.resource.data);

      // Owner can update their own profile BUT cannot touch any trust field.
      allow update: if isOwner(uid)
        && (!('phoneVerified' in request.resource.data)
            || request.resource.data.phoneVerified == resource.data.phoneVerified)
        && (!('verified' in request.resource.data)
            || request.resource.data.verified == resource.data.verified)
        && (!('verifiedBy' in request.resource.data)
            || request.resource.data.verifiedBy == resource.data.verifiedBy)
        && (!('verifiedAt' in request.resource.data)
            || request.resource.data.verifiedAt == resource.data.verifiedAt);

      // Admin can flip any trust field.
      allow update: if isAdmin();

      allow delete: if isOwner(uid) || isAdmin();
    }

    // -----------------------------------------------------------------------
    // Admins (created only via Firebase Console)
    // -----------------------------------------------------------------------

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Listings
    // -----------------------------------------------------------------------

    match /listings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid;
      allow update: if isOwner(resource.data.sellerId)
        || isAdmin();
      allow delete: if isOwner(resource.data.sellerId)
        || isAdmin();
    }

    // -----------------------------------------------------------------------
    // Orders
    // -----------------------------------------------------------------------

    match /orders/{id} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Chats
    // -----------------------------------------------------------------------

    match /chats/{id} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Cart
    // -----------------------------------------------------------------------

    match /cart/{id} {
      allow read, write: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Favorites
    // -----------------------------------------------------------------------

    match /favorites/{id} {
      allow read, write: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Reports
    // -----------------------------------------------------------------------

    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Ratings
    // -----------------------------------------------------------------------

    match /ratings/{id} {
      // Anyone signed in can read a seller's ratings.
      allow read: if isSignedIn();
      // A buyer creates a rating document keyed by orderId (one per order).
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      // No updates / deletes — ratings are immutable.
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Blocked sellers
    // -----------------------------------------------------------------------

    match /blocked/{id} {
      allow read, write: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Verification requests (community verification)
    // -----------------------------------------------------------------------

    match /verificationRequests/{id} {
      // Only admins and the requesting seller can read.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.sellerUid == request.auth.uid);
      // A signed-in seller creates their own request.
      allow create: if isSignedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == "pending";
      // Only admins update (approve/reject).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
