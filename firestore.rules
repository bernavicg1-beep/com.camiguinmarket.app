rules_version = '2';

// Camiguin Market — Firestore security rules.
//
// Policy:
//   - Must be signed in (Firebase Auth) to read listings.
//   - Only the owner (sellerId == uid) can create, update, and delete
//     their own listing.
//   - No other collection is open; everything is denied by default.
//
// Deploy:  firebase deploy --only firestore:rules
// (or paste it into Firebase Console → Firestore → Rules).
//
// It is also deployed automatically by GitHub Actions (Firestore rules workflow)
// and tested in the Firestore emulator before it reaches production.

service cloud.firestore {
  match /databases/{database}/documents {

    // A listing is valid when the required fields exist and have the right types.
    function validListing(data) {
      return data.sellerId is string
        && data.sellerId.size() > 0
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.price is number
        && data.price >= 0
        && data.contact is string
        && data.contact.size() <= 60
        // Multiple photos are optional (max 6).
        && (!('imageUrls' in data) || data.imageUrls.size() <= 6)
        // Pickup coordinates are optional, but must be numbers when present.
        && (!('latitude' in data) || data.latitude == null || data.latitude is number)
        && (!('longitude' in data) || data.longitude == null || data.longitude is number);
    }

    // Moderator: an `admins/{uid}` document exists (written from the Console only).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The admins list is readable by signed-in users (so the app can check it),
    // but it cannot be written from the app.
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /listings/{listingId} {
      // Customers must be able to see listings, but they must be signed in.
      allow read: if request.auth != null;

      // Only the seller can create a listing in their own name.
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && validListing(request.resource.data);

      // Owner may edit their listing; any signed-in user may bump views/cartAdds by
      // exactly +1 (and nothing else). A listing can never change seller.
      allow update: if request.auth != null
        && request.resource.data.sellerId == resource.data.sellerId
        && (
          (resource.data.sellerId == request.auth.uid && validListing(request.resource.data))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'viewsByDay'])
             && request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cartAdds'])
             && request.resource.data.get('cartAdds', 0) == resource.data.get('cartAdds', 0) + 1
        );

      // Also used by account deletion (delete all of the user's listings),
      // and by moderation.
      allow delete: if request.auth != null
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Cart: a user can only read/write their own cart.
    match /carts/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Checkout idempotency guards: owner only.
    // Read and write are split deliberately: `request.resource` is undefined on
    // reads, so combining them denied the pre-checkout `get()` in checkoutCart.
    match /checkouts/{checkoutId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // User profile document. The owner can read/write their own profile; any
    // signed-in user can read a profile so buyers can view a seller's name,
    // photo, phone and email from a listing.
    // Verification fields (verified/verifiedBy/verifiedAt) are admin-only:
    // the owner's allow-list deliberately excludes them so a seller cannot
    // self-verify. An admin may change only those three fields.
    // `phoneVerified` stays owner-writable, but only when the ID token carries
    // the verified `phone_number` claim (or the value is carried unchanged).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photoUrl', 'phone', 'phoneVerified', 'gcashNumber', 'telegram', 'messenger', 'whatsapp', 'telegramVerified', 'messengerVerified'])
          && (!('uid' in request.resource.data) || request.resource.data.uid is string)
          && (!('name' in request.resource.data) || request.resource.data.name is string)
          && (!('email' in request.resource.data) || request.resource.data.email is string)
          && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl is string)
          && (!('phone' in request.resource.data) || request.resource.data.phone is string)
          && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified is bool)
          && (!('gcashNumber' in request.resource.data) || request.resource.data.gcashNumber is string)
          && (!('gcashNumber' in request.resource.data) || request.resource.data.gcashNumber == '' || (request.resource.data.gcashNumber.size() == 11 && request.resource.data.gcashNumber.matches('09[0-9]{9}')))
          && (!('telegram' in request.resource.data) || request.resource.data.telegram is string)
          && (!('messenger' in request.resource.data) || request.resource.data.messenger is string)
          && (!('whatsapp' in request.resource.data) || request.resource.data.whatsapp is string)
          && (!('telegramVerified' in request.resource.data) || request.resource.data.telegramVerified is bool)
          && (!('messengerVerified' in request.resource.data) || request.resource.data.messengerVerified is bool)
          // A verified-phone badge must be backed by the phone claim Firebase
          // Auth puts in the ID token, not by a client assertion. Turning it
          // on is only allowed for the number the user actually verified; an
          // existing true value may be carried along while the phone is unchanged.
          && (
            !('phoneVerified' in request.resource.data)
            || request.resource.data.phoneVerified == false
            || (
              'phone' in request.resource.data
              && request.resource.data.phone is string
              && (
                ('phone_number' in request.auth.token
                  && request.auth.token.phone_number == request.resource.data.phone)
                || (resource != null
                  && resource.data.get('phoneVerified', false) == true
                  && request.resource.data.phone == resource.data.get('phone', ''))
              )
            )
          ))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verifiedBy', 'verifiedAt'])
          && (!('verified' in request.resource.data) || request.resource.data.verified is bool)
          && (!('verifiedBy' in request.resource.data) || request.resource.data.verifiedBy is string)
          && (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt is number))
      );
    }

    // FCM tokens: only the owner can read/write.
    match /users/{userId}/tokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Saved searches: owner only.
    match /savedSearches/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Favorites: like the cart, owner only.
    match /favorites/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications: only the owner can read and update; any signed-in
    // user can create a notification for someone else, but `fromUid`
    // must be themselves (nobody can impersonate another user).
    match /notifications/{userId}/items/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      // Only the inbox owner may create a notification in their own inbox;
      // fromUid must still be the caller so nobody can impersonate a sender.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200;
    }

    // Reports: any signed-in user can create their own
    // report; only the reporter and an admin can read it; only an admin can update it.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == "open";

      allow read: if isAdmin()
        || (request.auth != null && resource.data.reporterUid == request.auth.uid);

      allow update: if isAdmin();
      allow delete: if false;
    }

    // Orders: the buyer creates; only the buyer and the seller can read.
    // Only the seller can change the status.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.status == "pending"
        && (
          !('paymentMethod' in request.resource.data)
          || (request.resource.data.paymentMethod is string
              && (
                (request.resource.data.paymentMethod == "cash"
                  && request.resource.data.get('paymentStatus', '') == "cod")
                || (request.resource.data.paymentMethod == "gcash"
                    && request.resource.data.get('paymentStatus', '') == "unpaid")
              ))
        );

      // The seller can change the status at any time; the buyer can cancel
      // only while `pending`, and cannot swap the order's parties or the
      // payment method. A buyer may also record a GCash reference (moving
      // paymentStatus to "pending") but never mark an order paid; only the
      // seller verifies payment, and a cash order can never be marked paid.
      allow update: if request.auth != null
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.get('paymentMethod', null) == resource.data.get('paymentMethod', null)
        && (
          (resource.data.sellerId == request.auth.uid
            && !(resource.data.get('paymentMethod', '') == 'cash'
                 && request.resource.data.get('paymentStatus', '') == 'paid'))
          || (resource.data.buyerId == request.auth.uid
              && resource.data.status == "pending"
              && request.resource.data.status == "cancelled"
              && request.resource.data.get('paymentStatus', resource.data.get('paymentStatus', ''))
                 == resource.data.get('paymentStatus', ''))
          || (resource.data.buyerId == request.auth.uid
              && resource.data.status == "pending"
              && request.resource.data.status == "pending"
              && request.resource.data.get('paymentStatus', '') == "pending"
              && resource.data.get('paymentMethod', '') == "gcash")
        );

      allow delete: if false;
    }

    // Ratings: one rating per order (doc id = order id), and only the buyer
    // of a `done` order can create it.
    match /ratings/{orderId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.orderId == orderId
        && request.resource.data.sellerId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId
             == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == "done";

      allow update, delete: if false;
    }

    // Chat: only the two participants can read/write.
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;
        allow update, delete: if false;
      }
    }

    // Verification requests: a seller asks for community verification;
    // admins review/approve/reject. Only the requester and admins can read.
    match /verificationRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.sellerName is string
        && request.resource.data.createdAt is number;

      allow read: if isAdmin()
        || (request.auth != null && resource.data.sellerUid == request.auth.uid);

      allow update: if isAdmin();
      allow delete: if false;
    }

    // Announcements: admin-only writes; any signed-in user can read.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.authorUid is string
        && request.resource.data.active is bool
        && request.resource.data.createdAt is number;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Default deny for every other path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
